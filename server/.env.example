# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=kotti_game
MYSQL_USER=kotti
MYSQL_PASSWORD=kottipassword

# Application Server Configuration
PORT=8080
SESSION_TTL_MINUTES=60

# VOICEVOX Configuration
# VOICEVOXがホストマシン上で動作している場合は host.docker.internal を使用
VOICEVOX_API_URL=http://host.docker.internal:50021
VOICEVOX_SPEAKER_ID=84

# Audio File Configuration
AUDIO_OUTPUT_DIR=/app/audio_files
AUDIO_URL_PREFIX=/audio

# S3 Configuration (Production only)
USE_S3_FOR_AUDIO=false
S3_BUCKET_NAME=
S3_REGION=ap-northeast-1

# VAPID Keys for Push Notifications
# Generate keys using: go run cmd/generate-vapid/main.go
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
